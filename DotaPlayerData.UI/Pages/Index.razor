@page "/"
@using DotaPlayerData.UI.Data
@using DotaPlayerData.Core.Models
@using DotaPlayerData.Core.Models.OpenDota
@inject SearchController SearchController

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudPaper Elevation="3" Class="pa-4 mb-4">
        <MudText Typo="Typo.h4" Class="mb-4">Dota 2 Player Search</MudText>
        <MudGrid>
            <MudItem xs="12" sm="9" md="10">
                <MudTextField @bind-Value="_steamId"
                              Label="Search Player"
                              Placeholder="Enter Steam ID or player name"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Disabled="@_isLoading"
                              OnKeyDown="@OnKeyDown"
                              FullWidth="true"/>
            </MudItem>
            <MudItem xs="12" sm="3" md="2" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="OnSearchClick"
                           Disabled="@_isLoading"
                           FullWidth="true"
                           Size="Size.Large">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                        <span>Loading...</span>
                    }
                    else
                    {
                        <span>Search</span>
                    }
                </MudButton>
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
            Tip: Enter a numeric Steam ID for direct lookup, or a player name to search
        </MudText>
    </MudPaper>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4"/>
    }

    @if (_playerHeroes != null && _playerInfos != null)
    {
        <MudTabs Elevation="4" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
            <MudTabPanel Text="Player Info" Icon="@Icons.Material.Filled.Person">
                <PlayerInfos PlayerData="_playerInfos"/>
            </MudTabPanel>
            <MudTabPanel Text="Heroes Played" Icon="@Icons.Material.Filled.SportsEsports">
                <PlayerHeroesGrid PlayerHeroes="_playerHeroes"/>
            </MudTabPanel>
            <MudTabPanel Text="Teammates" Icon="@Icons.Material.Filled.Groups">
                <PlayerTeammates SteamId="_currentSteamId"/>
            </MudTabPanel>
        </MudTabs>
    }

    @if (_playerResults != null)
    {
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Search Results (@_playerResults.Count() players found)</MudText>
            <SearchResultGrid SearchPlayerResults="_playerResults" OnPlayerSelected="@LoadPlayerData"/>
        </MudPaper>
    }
</MudContainer>

@code
{
    private string _steamId;
    private IEnumerable<PlayerHero> _playerHeroes;
    private IEnumerable<SearchPlayerResult> _playerResults;
    private Player _playerInfos;
    private bool _isLoading;
    private long _currentSteamId;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await OnSearchClick();
        }
    }

    private async Task OnSearchClick()
    {
        if (string.IsNullOrEmpty(_steamId))
        {
            return;
        }

        _isLoading = true;
        StateHasChanged();

        try
        {
            if (long.TryParse(_steamId, out long id))
            {
                _currentSteamId = id;
                _playerHeroes = await SearchController.SearchTopPlayerHeroes(id);
                _playerInfos = await SearchController.SearchPlayerInfos(id);
                _playerResults = null;
            }
            else
            {
                _playerResults = await SearchController.SearchPlayer(_steamId);
                _playerHeroes = null;
                _playerInfos = null;
            }
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async void LoadPlayerData(int accountId)
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            _currentSteamId = accountId;
            _playerHeroes = await SearchController.SearchTopPlayerHeroes(accountId);
            _playerInfos = await SearchController.SearchPlayerInfos(accountId);
            _playerResults = null;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}
